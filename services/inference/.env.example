# Matcha AI Inference Service — Environment Variables

# AI Engine Keys
GEMINI_API_KEY=your_gemini_api_key_here
HF_TOKEN=your_huggingface_token_here

# Roboflow Config (Optional for ball detection)
ROBOFLOW_API_KEY=your_roboflow_key
ROBOFLOW_WORKSPACE=matcha-ai
ROBOFLOW_PROJECT=soccer-ball-detection
ROBOFLOW_VERSION=1

# Orchestration
ORCHESTRATOR_URL=http://localhost:4000/api/v1

# Resource Management
ENABLE_GPU_ACCELERATION=true
PARALLEL_WORKERS=4
